# Copy to `.env` and edit. Everything is prefixed LOCAL_CHORUS_ to avoid collisions.

# --- Ollama ---
LOCAL_CHORUS_OLLAMA_URL=http://localhost:11434
LOCAL_CHORUS_OLLAMA_MODEL=llama3.1:8b
LOCAL_CHORUS_OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Behavior ---
LOCAL_CHORUS_REQUEST_TIMEOUT_S=60
LOCAL_CHORUS_LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR
